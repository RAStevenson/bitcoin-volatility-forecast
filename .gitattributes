# Line-ending rules live in the repo rather than in each machine's
# core.autocrlf setting, so a fresh clone behaves the same way anywhere.

* text=auto

*.jsonl text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf

*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.parquet binary
*.pkl binary
*.zip binary
*.db binary
*.sqlite binary
